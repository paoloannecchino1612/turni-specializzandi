rules_version = '2';
// Regole di sicurezza del database. Prima di pubblicarle nella console di Firebase
// sostituisci EMAIL_PROPRIETARIO con la tua email (tutta in minuscolo).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner() { return signedIn() && request.auth.token.email.lower() == "EMAIL_PROPRIETARIO"; }
    function allowed() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/access/allow)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/access/allow).data.emails);
    }
    // gestori: "uids" = 2° anno (documenti di sempre), "y1"/"y3"/"y4" = gestori degli altri anni
    function mgrList(k) {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/managers)
        && request.auth.uid in get(/databases/$(database)/documents/roles/managers).data.get(k, []);
    }
    function isManager() { return mgrList("uids") || mgrList("y1") || mgrList("y3") || mgrList("y4"); }
    function isAdmin() { return isOwner() || (allowed() && isManager()); }

    // serve all'app per sapere se chi entra è il proprietario
    match /roles/owner { allow read, write: if isOwner(); }
    // elenco gestori (uid), lo scrive solo il proprietario
    match /roles/managers { allow read: if allowed(); allow write: if isOwner(); }
    // email autorizzate: ognuno può leggere l'elenco per sapere se è ammesso, solo il proprietario lo modifica
    match /access/allow { allow read: if signedIn(); allow write: if isOwner(); }

    // richieste di accesso: chi non è autorizzato scrive la propria; solo il proprietario le vede e le chiude
    match /accessRequests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.email == request.auth.token.email.lower();
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow delete: if isOwner();
    }

    // impostazioni del tool e turni dei mesi: tutti leggono, proprietario e gestori scrivono
    // ogni anno: config/main + planner/state (2° anno), config/yN + planner/yN (altri anni); scrive il proprietario o i gestori di quell'anno
    match /config/{doc} { allow read: if allowed(); allow write: if isOwner() || (allowed() && ((doc == "main" && mgrList("uids")) || (doc != "main" && mgrList(doc)))); }
    match /planner/{doc} { allow read: if allowed(); allow write: if isOwner() || (allowed() && ((doc == "state" && mgrList("uids")) || (doc != "state" && mgrList(doc)))); }

    // indisponibilità: ognuno scrive solo le proprie; il proprietario anche quelle degli altri e lo spazio "staff"
    // si accettano modifiche fino a 2 giorni prima del primo lunedì del mese (doc = "AAAA-MM_pid"); dopo solo proprietario e gestori, che possono modificare anche quelle degli altri
    function beforeDeadline(docId) {
      let p = docId.split('_')[0].split('-');
      let first = timestamp.date(int(p[0]), int(p[1]), 1);
      let off = (8 - first.dayOfWeek()) % 7;
      return request.time < first + duration.value(off - 1, 'd');
    }
    match /unav/{uid}/m/{doc} {
      allow read: if allowed();
      allow write: if isAdmin() || (allowed() && request.auth.uid == uid && beforeDeadline(doc));
    }

    // collegamento nome-account: ognuno il proprio; il proprietario può scollegare chiunque
    // collegamento nome-account: ognuno lo crea una sola volta per sé; modificarlo o cancellarlo può solo il proprietario
    match /claims/{uid} {
      allow read: if allowed();
      allow create: if allowed() && (request.auth.uid == uid || isOwner());
      allow update, delete: if isOwner();
    }

    // cambi turno: tutti gli autorizzati creano e rispondono; solo proprietario e gestori eliminano
    match /swaps/{id} {
      allow read, create, update: if allowed();
      allow delete: if isAdmin();
    }
  }
}
